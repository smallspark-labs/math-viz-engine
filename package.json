{
  "name": "@smallspark/math-viz-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic SVG visualizations for elementary math concepts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "playground:dev": "npm --prefix playground run dev",
    "playground:build": "npm --prefix playground run build"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
